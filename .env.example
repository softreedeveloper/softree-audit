# ─────────────────────────────────────────────────────────────
# Softree Audit — configuración de ejemplo
# Copiar a .env y reemplazar los valores. Nunca subir .env a Git.
# ─────────────────────────────────────────────────────────────

# Entorno: development | staging | production
APP_ENV=development
APP_URL=http://localhost:4321
API_URL=http://localhost:8000
LOG_LEVEL=INFO
# Formato de log: json | console
LOG_FORMAT=console

# Clave de firma de tokens y derivación de cifrado.
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo 32 caracteres. Este valor de ejemplo se rechaza fuera de development.
SECRET_KEY=CHANGE_ME_generate_a_real_random_value_of_at_least_32_chars
# Clave anterior, solo durante una rotación de secretos.
SECRET_KEY_PREVIOUS=

# Base de datos
POSTGRES_USER=softree
POSTGRES_PASSWORD=softree_local_password
POSTGRES_DB=softree_audit
DATABASE_URL=postgresql+asyncpg://softree:softree_local_password@postgres:5432/softree_audit
# Base de datos y Redis para pruebas de integración.
# Si TEST_DATABASE_URL está vacía, esas pruebas se omiten con un motivo explícito.
TEST_DATABASE_URL=postgresql+asyncpg://softree:softree_local_password@postgres:5432/softree_audit_test
TEST_REDIS_URL=redis://redis:6379/15

# Redis
REDIS_URL=redis://redis:6379/0

# Sesión
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Orígenes permitidos. Vacío cuando frontend y API comparten origen.
CORS_ORIGINS=

# OWASP ZAP (perfil scanner)
ZAP_URL=http://zap:8080
ZAP_API_KEY=CHANGE_ME_zap_api_key
ZAP_TIMEOUT_SECONDS=900

# Google PageSpeed Insights
PAGESPEED_API_KEY=
PAGESPEED_CACHE_TTL_SECONDS=21600

# Google OAuth (Search Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir carácter por carácter con el URI registrado en Google Cloud
# Console. Es el origen de la interfaz, no el de la API: el servidor de
# desarrollo hace proxy de /api y así la vuelta aterriza en la aplicación.
GOOGLE_REDIRECT_URI=http://localhost:4321/api/v1/integrations/google/callback

# Pesos del Softree Score. JSON. Se renormalizan si alguna categoría falta.
SCORING_WEIGHTS={"security":0.30,"performance":0.25,"seo":0.25,"accessibility":0.10,"best_practices":0.10}

# Seguridad del scanner
# Permitir redes privadas SOLO en desarrollo. Necesario para auditar el
# test-target, que vive en la red interna de Docker. Con el valor false, el
# guard rechaza el scan con `target_unreachable` / `blocked_network`, que es
# el comportamiento correcto en producción.
SSRF_ALLOW_PRIVATE_NETWORKS=false
SSRF_ALLOWED_PORTS=80,443
MAX_RESPONSE_BYTES=5242880

# Worker (se usa a partir del Slice 3)
WORKER_MAX_JOBS=2
SCAN_TIMEOUT_SECONDS=3600

# Almacenamiento de reportes
REPORTS_DIR=/data/reports

# Frontend
PUBLIC_API_BASE_URL=/api/v1
