---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Auditoría interna de seguridad, SEO y rendimiento web.' } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title} · Softree Audit</title>
    <script is:inline>
      // Aplica el tema antes del primer pintado para evitar destello.
      try {
        const stored = localStorage.getItem('softree-audit-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (error) {
        /* almacenamiento no disponible: se usa la preferencia del sistema */
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
